{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easytidy-gui",
  "version": "0.1.0",
  "identifier": "io.github.dingiv.easytidy",
  "build": {
    "beforeDevCommand": {
      "script": "sh -c 'cargo build -p easytidy-server --target x86_64-unknown-linux-musl && pnpm dev'",
      "cwd": "."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "sh -c 'cargo build -p easytidy-server --release --target x86_64-unknown-linux-musl && pnpm build'",
      "cwd": "."
    },
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "easytidy GUI",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}