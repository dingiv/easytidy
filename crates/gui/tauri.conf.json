{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easytidy-gui",
  "version": "0.1.0",
  "identifier": "io.github.dingiv.easytidy",
  "build": {
    "beforeDevCommand": "bash ../scripts/dev-ui.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash ../scripts/build-ui.sh",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "easytidy GUI",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}